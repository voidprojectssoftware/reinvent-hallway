{
  "name": "reinvent-hallway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "npm run verify:factory && npm run typecheck && npm run boundaries && npm test && npm run test:e2e && npm run build && npm run check:no-toolbar",
    "verify:factory": "node scripts/check-adr-numbers.mjs && node --test 'scripts/**/*.test.mjs'",
    "typecheck": "npm run types:check -w @hallway/api && tsc -p tsconfig.json && tsc -p packages/domain/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p apps/api/tsconfig.node.json && tsc -p apps/web/tsconfig.json",
    "build": "npm run build -w @hallway/web && node apps/api/scripts/copy-card-fonts.mjs",
    "boundaries": "depcruise apps packages",
    "test": "vitest run",
    "dev": "node apps/api/scripts/dev.mjs",
    "aspire": "node scripts/aspire.mjs",
    "aspire:stop": "node scripts/aspire.mjs stop",
    "seed:demo": "node scripts/seed-demo.mjs",
    "fake:linkedin": "node scripts/fake-linkedin.mjs",
    "db:generate": "node scripts/generate-migration.mjs",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "tiles": "node scripts/venues/cut-tiles.mjs",
    "notes": "node scripts/notes.mjs",
    "check:no-toolbar": "node scripts/check-no-toolbar.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "agentation-mcp": "1.3.2",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "pmtiles": "4.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vscode-jsonrpc": "8.2.1"
  }
}
