// The parts of apps/api that run under Node: the vitest tests. The Worker code
// they import is checked here too, with Node's globals; tsconfig.json is the
// check that holds it to the Workers runtime.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"]
}
