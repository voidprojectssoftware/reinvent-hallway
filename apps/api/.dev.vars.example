# Local settings for `npm run dev`. scripts/dev.mjs copies this to .dev.vars
# (git-ignored) when there is none; wrangler types reads this file, not
# .dev.vars, so the generated Env is the same on every checkout.

# Dev sign-in (src/auth/dev-sign-in.ts): POST /api/dev/sign-in { name } and
# `Authorization: Bearer dev:<attendeeId>`, on a loopback host only.
DEV_SIGN_IN=1

# Sign in with Google, Microsoft, LinkedIn or GitHub (ADR 0018). Each is empty
# until the owner creates that provider's OAuth app (#62); a provider answers
# 404, and GET /api/auth/options leaves it out, while either of its pair is
# empty. Put real values in .dev.vars, never here. Each app's redirect URI is
# <origin>/api/auth/<provider>/callback. Microsoft's app registration must
# also add the optional ID token claim `xms_edov`, or work accounts' emails
# stay unverified.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
