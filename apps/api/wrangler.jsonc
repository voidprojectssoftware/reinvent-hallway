// The one Worker (ADR 0002): /api REST, /mcp, /cal, and the web app's build as
// static assets. Local only: there is no deploy, and adding one needs the
// owner (AGENTS.md). `npm run dev` from the root serves it (scripts/dev.mjs).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hallway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",

  "vars": {
    // A session's link is this with `{code}` filled in (domain.md "Session
    // link"): AWS's public catalog searched for the code, which opens with
    // that session first (measured 2026-11-13, issue #103, closing #19).
    // Changing it needs no migration, since the link is derived, never stored.
    "SESSION_URL_TEMPLATE": "https://registration.awsevents.com/flow/awsevents/reinvent2026/eventcatalog/page/eventcatalog?search={code}",
    // The off switch for session descriptions (issue #103): "0" hides them
    // from session search and get, the only reads that carry them, so from
    // REST, MCP and the web at once. Anything else, or unset, shows them.
    "SHOW_SESSION_DESCRIPTIONS": "1",
  },

  // D1, read as `env.DB`. No database_id: locally wrangler keeps it under
  // --persist-to, which scripts/dev.mjs points inside this worktree.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hallway",
      "migrations_dir": "../../migrations",
    },
  ],

  // apps/web's build (ADR 0005). Assets answer first, except on the paths
  // below, which are the Worker's; any other path that is not a file gets
  // index.html, the SPA's client-side route. scripts/dev.mjs builds apps/web
  // here before wrangler starts (it refuses a missing directory) and keeps
  // rebuilding it on change.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /@* is the web app's, but served by the Worker: src/person-page.ts.
    // /.well-known/* is the Worker's so it answers a JSON 404, not the SPA:
    // an MCP client looking for OAuth metadata there must not parse HTML (hunt F13).
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/cal/*", "/og/*", "/@*", "/.well-known/*"],
  },

  // The share card's font files arrive as ArrayBuffers (src/sharing/
  // worker-renderer.ts); a `.wasm` import is a compiled module by default.
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],

  // No "build" command here. The share card's fallback fonts (ADR 0012) are
  // copied into the assets directory by whatever starts wrangler
  // (scripts/copy-card-fonts.mjs: apps/api/scripts/dev.mjs,
  // scripts/aspire-api.mjs, e2e/hallway-worker.ts and `npm run build`). With a
  // custom build, wrangler 4.160 to 4.162 never reloads the assets after a
  // change under ../web/dist: its asset watcher refreshes only a bundle its own
  // esbuild made, so after a web rebuild it kept the manifest from startup,
  // served a new hashed bundle as index.html (a blank page) and the old
  // index.html's ETag (a stale page). Issue #85.
}
