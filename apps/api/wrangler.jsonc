// The one Worker (ADR 0002): /api REST, /mcp, /cal, and the web app's build as
// static assets. Local only: there is no deploy, and adding one needs the
// owner (AGENTS.md). `npm run dev` from the root serves it (scripts/dev.mjs).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hallway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",

  // A session's link is this with `{code}` filled in (domain.md "Session
  // link"). ASSUMPTION: the re:Invent catalog searched for the code, until the
  // owner confirms the deep-link format (issue #19); changing it needs no
  // migration, since the link is derived, never stored.
  "vars": {
    "SESSION_URL_TEMPLATE": "https://registration.awsevents.com/flow/awsevents/reinvent2026/event-catalog/page/eventCatalog?search={code}",
  },

  // D1, read as `env.DB`. No database_id: locally wrangler keeps it under
  // --persist-to, which scripts/dev.mjs points inside this worktree.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hallway",
      "migrations_dir": "../../migrations",
    },
  ],

  // apps/web's build (ADR 0005). Assets answer first, except on the paths
  // below, which are the Worker's; any other path that is not a file gets
  // index.html, the SPA's client-side route. scripts/dev.mjs builds apps/web
  // here before wrangler starts (it refuses a missing directory) and keeps
  // rebuilding it on change.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /@* is the web app's, but served by the Worker: src/person-page.ts.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/cal/*", "/og/*", "/@*"],
  },

  // The share card's font files arrive as ArrayBuffers (src/sharing/
  // worker-renderer.ts); a `.wasm` import is a compiled module by default.
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
}
